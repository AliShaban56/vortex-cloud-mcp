# Turso libSQL (required)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Server admin secret (required for admin endpoints: create enrollments/instances)
# Never commit it and never embed it in desktop apps.
VORTEX_ADMIN_SECRET=

# Optional tuning
VORTEX_DEVICE_STALE_SECONDS=45
VORTEX_MCP_WAIT_MS=7000
VORTEX_COMMAND_TTL_MS=600000
VORTEX_STALE_RUNNING_MS=90000
